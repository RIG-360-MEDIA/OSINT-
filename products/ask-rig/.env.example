# ---- READ-ONLY corpus DB (reach it via scripts/tunnel.ps1) ----
# Reuse the analytics_user password from products/osint/backend/.env (OSINT_DB_URL),
# but point host:port at the tunnel (localhost:15432). NEVER use a writable role here.
ASKRIG_DB_URL=postgresql+asyncpg://analytics_user:CHANGEME@localhost:15432/rig
ASKRIG_DB_POOL_SIZE=5
ASKRIG_DB_MAX_OVERFLOW=10

# ---- retrieval ----
ASKRIG_EMBED_MODEL=sentence-transformers/LaBSE
ASKRIG_K_VEC=30
ASKRIG_K_LEX=30
ASKRIG_RRF_K=60
ASKRIG_TOP_K=8
# tsquery config; 'simple' is language-agnostic. Align with how articles.fts was built.
ASKRIG_FTS_CONFIG=simple

# ---- reranker (bge-reranker-v2-m3 via sentence-transformers CrossEncoder) ----
# Set ASKRIG_RERANK_ENABLED=false to skip (faster startup / lower memory, lower quality).
ASKRIG_RERANK_ENABLED=true
ASKRIG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
ASKRIG_RERANK_FETCH_K=50    # candidates fetched from hybrid before reranking
ASKRIG_RERANK_TOP_N=20      # keep after rerank, before diversity

# ---- diversity ----
ASKRIG_DEDUP_THRESHOLD=0.65    # title Jaccard above this → drop near-duplicate
ASKRIG_DIVERSITY_LAMBDA=0.65   # MMR λ: 1=pure relevance, 0=pure diversity
ASKRIG_MAX_PER_SOURCE=2        # max docs per source_id in final context

# ---- answer (LLM, OpenAI-compatible; default Groq) ----
ASKRIG_ANSWER_ENABLED=true
ASKRIG_LLM_PROVIDER=groq
ASKRIG_LLM_BASE_URL=https://api.groq.com/openai/v1
ASKRIG_LLM_MODEL=llama-3.3-70b-versatile
# Key POOL (comma-separated) — rotated automatically on Groq 429 (per-key/per-model
# daily token limit). Reuse GROQ_API_KEYS from products/osint/backend/.env.
ASKRIG_LLM_API_KEYS=
# Single-key fallback (used only if ASKRIG_LLM_API_KEYS is empty).
ASKRIG_LLM_API_KEY=
ASKRIG_LLM_TEMPERATURE=0.2

# ---- app DB (Set 2 — writable per-user state; SEPARATE from the read-only corpus) ----
# Default SQLite (zero-infra, file in the ask-rig dir). Swap to Postgres in prod:
#   ASKRIG_APP_DB_URL=postgresql+asyncpg://user:pw@host:5432/askrig_app
ASKRIG_APP_DB_URL=sqlite+aiosqlite:///./askrig_app.db

# ---- live web (Set 3) ----
ASKRIG_WEB_ENABLED=true
# rig-searxng JSON endpoint. Locally there's usually none → web gracefully degrades
# (corpus-only). Point at the deployment's SearXNG to actually fuse web results.
ASKRIG_SEARXNG_URL=http://localhost:8888
ASKRIG_WEB_MAX_RESULTS=6
ASKRIG_WEB_FETCH_TIMEOUT=8
ASKRIG_WEB_MAX_BYTES=2000000

# ---- server ----
ASKRIG_HOST=127.0.0.1
ASKRIG_PORT=8010
ASKRIG_CORS_ORIGINS=
ASKRIG_LOG_LEVEL=INFO
