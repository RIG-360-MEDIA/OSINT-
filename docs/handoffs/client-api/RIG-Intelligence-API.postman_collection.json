                  "value": "",
                  "description": "Entity id(s) to filter by (repeatable)",
                  "disabled": true
                },
                {
                  "key": "topic",
                  "value": "",
                  "description": "Topic(s) to filter by (repeatable)",
                  "disabled": true
                },
                {
                  "key": "match",
                  "value": "any",
                  "description": "Combine filters with OR (any) or AND (all)",
                  "disabled": true
                },
                {
                  "key": "sentiment",
                  "value": "",
                  "description": "",
                  "disabled": true
                },
                {
                  "key": "window",
                  "value": "7",
                  "description": "Days to look back",
                  "disabled": true
                },
                {
                  "key": "language",
                  "value": "",
                  "description": "",
                  "disabled": true
                },
                {
                  "key": "source",
                  "value": "",
                  "description": "Outlet name(s) to filter by (repeatable) — drill-down from /analytics/outlets",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Items per page (values above 100 are clamped to 100)",
                  "disabled": true
                },
                {
                  "key": "cursor",
                  "value": "",
                  "description": "",
                  "disabled": true
                }
              ],
              "variable": [
                {
                  "key": "entity_id",
                  "value": "",
                  "description": "required"
                }
              ]
            },
            "description": "All coverage about one entity (articles + clips + cuttings)"
          }
        }
