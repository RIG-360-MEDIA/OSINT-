# Client API gateway — dedicated host. /v1/* -> osint-backend (path preserved).
# Staff /v1/admin/* blocked here (stays internal via /osint/v1/admin).
api.rig360media.com {
    encode gzip zstd
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
    }
    @admin path /v1/admin/*
    handle @admin {
        respond "Not found" 404
    }
    handle /v1/* {
        reverse_proxy osint-backend:8000
    }
    redir /geo /geo/
    handle_path /geo/* {
        reverse_proxy riggeo:8700
    }
    redir /media /media/
    handle_path /media/* {
        reverse_proxy rigmedia:8701
    }
    redir /identity /identity/
    handle_path /identity/* {
        reverse_proxy rigident:8702
    }
    # Scout — app routes are baked as /scout/*, so DON'T strip the prefix.
    # The app's only un-prefixed routes are / (UI) and /health -> map them explicitly.
    handle /scout/health {
        rewrite * /health
        reverse_proxy rigscout:8610
    }
    handle /scout {
        rewrite * /
        reverse_proxy rigscout:8610
    }
    handle /scout/ {
        rewrite * /
        reverse_proxy rigscout:8610
    }
    handle /scout/* {
        reverse_proxy rigscout:8610
    }
    handle {
        respond "Not found" 404
    }
    log {
        output stdout
    }
}
