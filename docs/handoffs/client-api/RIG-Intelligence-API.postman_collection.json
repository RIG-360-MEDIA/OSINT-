{
  "info": {
    "name": "RIG Intelligence API (v1)",
    "description": "Read API over your provisioned intelligence scope — news articles, newspaper cuttings, and YouTube — with directed sentiment, grouped stories, geography, briefings, and programmatic control of your own coverage scope.\n\nAuthenticate with your key as `Authorization: Bearer rig_live_…` (or `X-API-Key`). Your key encodes your organisation and scope; every response is filtered to it.\n\nSet the `apiKey` collection variable to your `rig_live_…` key.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.rig360media.com",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "rig_live_REPLACE_ME",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "scope",
      "item": [
        {
          "name": "Read your org's provisioned scope",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/scope",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "scope"
              ]
            },
            "description": "Read your org's provisioned scope"
          }
        },
        {
          "name": "Manage your scope (management key required)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/scope",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "scope"
              ]
            },
            "description": "Manage your scope (management key required)",
            "body": {
              "mode": "raw",
              "raw": "{\n  \n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Explicitly purge your scope + webhooks (confirm required)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/scope/purge",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "scope",
                "purge"
              ]
            },
            "description": "Explicitly purge your scope + webhooks (confirm required)",
            "body": {
              "mode": "raw",
              "raw": "{\n  \n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
